CREATE SET TABLE FOODMART.trimmed_customer
     (
      customer_id INTEGER NOT NULL,
      account_num BIGINT NOT NULL,
      lname VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      fname VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      mi VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      address1 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      address2 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      address3 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      address4 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      city VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      state_province VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      postal_code VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      country VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      customer_region_id INTEGER NOT NULL,
      phone1 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      phone2 VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      birthdate DATE FORMAT 'YY/MM/DD' NOT NULL,
      marital_status VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      yearly_income VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      gender VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      total_children SMALLINT NOT NULL,
      num_children_at_home SMALLINT NOT NULL,
      education VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      date_accnt_opened DATE FORMAT 'YY/MM/DD' NOT NULL,
      member_card VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      occupation VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      houseowner VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      num_cars_owned INTEGER,
      fullname VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL);

